{
  "name": "tverdynya",
  "private": true,
  "version": "0.2.0",
  "description": "Твердыня — 2D roguelite city-builder о мифической Руси",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "desktop:dev": "npm run build && electron .",
    "desktop:package": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "phaser": "^3.88.2"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.2.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "ru.tverdynya.game",
    "productName": "Твердыня",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable"
    }
  }
}
